# Anthropic — get at console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI — used only for embeddings, get at platform.openai.com
OPENAI_API_KEY=

# GitHub OAuth App — create at github.com/settings/developers → OAuth Apps
# Homepage URL: http://localhost:3000
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# NextAuth — generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Backend base URL (for frontend to call)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
