# Copy to frontend/.env.local — Next.js only reads env files from this directory.

# NextAuth v5 (AUTH_SECRET is the v5 name; NEXTAUTH_SECRET kept for compat)
# Generate with: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth App — github.com/settings/developers → OAuth Apps
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# FastAPI backend base URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Optional: must match the backend's BACKEND_API_KEY when that is set.
# Exposed to the browser — deters casual abuse only.
NEXT_PUBLIC_BACKEND_API_KEY=
